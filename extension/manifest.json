{
  "manifest_version": 3,
  "name": "蝦皮特賣分潤小幫手",
  "version": "1.3.1",
  "description": "抓蝦皮限時特賣與特價商品（含場次日期時間、開賣倒數），用你登入的分潤後台轉成分潤連結，生成情境文案，並用你登入的 Chrome 發到 Threads／Facebook 粉絲專頁、搜尋 Threads 後逐篇回覆。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://shopee.tw/*",
    "https://affiliate.shopee.tw/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "蝦皮特賣分潤小幫手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.tw/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.tw/*"
      ],
      "js": [
        "lib/parse.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://affiliate.shopee.tw/*"
      ],
      "js": [
        "inject_affiliate.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://affiliate.shopee.tw/*"
      ],
      "js": [
        "lib/affiliate.js",
        "affiliate_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "lib/social.js",
        "social_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}