# 這個檔案通常不用手改：啟動程式後到網頁「設定」頁填 API key、選供應商，會自動寫入 .env。
# 想手改也可以，下面是全部選項。

# ===== 腳本文案：AI 看商品說明+商品圖，自己歸納 3 賣點、寫腳本/標題/文案 =====
# gemini（有免費額度）| openai | claude | template（不用 AI，吃你填的賣點）
TEXT_PROVIDER=gemini
TEXT_MODEL=

# ===== 圖片：賣家圖只當參考，重新生成全新商品圖 =====
# gemini | openai | browser（操控你的 Chrome 用 Gemini 網頁，免 API）| manual（手動上傳）
IMAGE_PROVIDER=gemini
IMAGE_MODEL=
IMAGES_PER_PRODUCT=5

# ===== 影片 =====
# slideshow（用圖合成，免費）| veo（Gemini API）| fal（fal.ai 的 Kling 等）
# | flow_browser（操控你的 Chrome 用 Flow 點數）| flow（手動上傳 Flow 影片）
VIDEO_PROVIDER=slideshow
VIDEO_MODEL=
VIDEO_CLIP_SECONDS=0
FAL_EXTRA_ARGS=

# ===== API 金鑰（只存在你電腦）=====
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
FAL_KEY=

# ===== 配音與字幕 =====
TTS=1
TTS_VOICE=zh-TW-HsiaoChenNeural
SUBTITLES=1
FONT_PATH=

# ===== 流程與上架 =====
DAILY_GEN_CAP=10
DAILY_UPLOAD_CAP=5
# manual=只匯出上架包 | dryrun=自動填好不發佈（先測這個）| auto=自動發佈
UPLOAD_MODE=manual
SHOPEE_VIDEO_UPLOAD_URL=
AFFILIATE_PICKS_URL=
APP_PASSWORD=
POLL_SECONDS=60
PORT=8000

# ===== 瀏覽器自動化（browser / flow_browser 模式）=====
CHROME_PATH=
CDP_PORT=9222
FLOW_CLIPS_PER_PRODUCT=2
DATA_DIR=data
