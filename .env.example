# ===== 全免費模式（預設）=====
# 圖 auto：有 GEMINI_API_KEY 就自動產，失敗(沒額度)自動改成「待產圖」頁手動上傳；manual：一律手動
# 影片 slideshow：5 張圖 + ffmpeg 合成 15 秒；flow：你用 Flow 點數產，上傳 mp4 回來（見「待產片」頁）
IMAGE_PROVIDER=auto
VIDEO_PROVIDER=slideshow
# 免費 edge-tts 配音（非官方服務，失敗會自動變無配音）；不要配音設 0
TTS=1
# 配音：zh-TW-HsiaoChenNeural = 曉臻（自然女聲）
TTS_VOICE=zh-TW-HsiaoChenNeural
# 影片是否燒入字幕（只會是賣點內容文字，不會出現「賣點1/hook/CTA」標籤）。完全不要字幕設 0
SUBTITLES=1
# 中文字型（通常自動找得到；找不到才填，例如 C:/Windows/Fonts/msjh.ttc）
FONT_PATH=

# ===== 腳本文案（可選）=====
# 填了：用 Gemini 免費額度的文字模型寫腳本。不填：用你在審圖頁輸入的賣點 + 範本。
# 到 https://aistudio.google.com 申請（Gemini 網頁訂閱 ≠ API key）
GEMINI_API_KEY=
TEXT_MODEL=gemini-2.5-flash

# ===== 付費選項（不想花錢就不要動）=====
# IMAGE_PROVIDER=api  用 API 產圖（是否有免費額度請看 AI Studio 的 rate limits 頁）
# VIDEO_PROVIDER=veo  用 Veo API 產片（沒有免費額度，按秒計費）
IMAGE_MODEL=gemini-2.5-flash-image
VIDEO_MODEL=veo-3.1-generate-preview
IMAGES_PER_PRODUCT=5

# ===== 上架 =====
# manual=只匯出上架包(手機/電腦自己傳) | dryrun=自動填好不發佈(第一次先跑這個) | auto=自動發佈
UPLOAD_MODE=manual
DAILY_UPLOAD_CAP=5
DAILY_GEN_CAP=10
POLL_SECONDS=60
PORT=8000
AFFILIATE_PICKS_URL=
SHOPEE_VIDEO_UPLOAD_URL=
DATA_DIR=data
