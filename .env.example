# 這個檔案通常不用手改：啟動程式後到網頁「設定」頁貼上 API key 就會自動寫入 .env 並立即生效。
# 供應商留 auto 即可：依填了哪個 key 自動啟用（Gemini > OpenAI > Claude / fal）。想手改也可以，下面是全部選項。

# ===== 腳本文案：AI 看商品說明+商品圖，自己歸納 3 賣點、寫腳本/標題/文案 =====
# auto（依 key 決定）| gemini | openai | claude | template（不用 AI，吃你填的賣點）
TEXT_PROVIDER=auto
TEXT_MODEL=

# ===== 圖片：賣家圖只當參考，重新生成全新商品圖 =====
# auto | gemini | openai | browser（操控你的 Chrome 用 Gemini 網頁，免 API）| manual（手動上傳）
IMAGE_PROVIDER=auto
IMAGE_MODEL=
# 新商品預設圖片來源：web=上網找圖當參考(AI 重新生成) | ai=純 AI 生成（每個商品可單獨改）
DEFAULT_IMAGE_SOURCE=web
IMAGES_PER_PRODUCT=5
# 新商品預設搭配的主角 id（0=不加人物；到「主角」頁設定比較方便）
DEFAULT_CHARACTER_ID=0

# ===== 影片：兩種類型，每個商品可在「審圖/待產圖」頁單獨選，這裡是預設 =====
# slideshow = A. 5 張圖合成 15 秒（免費，不用 API）
# ai        = B. 用新生成的圖 + 腳本，讓 AI 生成 15 秒影片（花 API 費用或 Flow 點數，受 DAILY_GEN_CAP 限制）
VIDEO_MODE=slideshow
# B 類型的引擎：auto | veo（Gemini API）| fal（fal.ai 的 Kling 等）| flow_browser（操控你的 Chrome 用 Flow 點數）| flow（手動上傳 Flow 影片）
VIDEO_PROVIDER=auto
VIDEO_MODEL=
VIDEO_CLIP_SECONDS=0
FAL_EXTRA_ARGS=

# ===== API 金鑰（只存在你電腦）=====
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
FAL_KEY=

# ===== 配音與字幕 =====
TTS=1
TTS_VOICE=zh-TW-HsiaoChenNeural
SUBTITLES=1
# 影片左上角顯示「AI 生成」標示
AI_LABEL=1
FONT_PATH=

# ===== 流程與上架 =====
DAILY_GEN_CAP=10
DAILY_UPLOAD_CAP=5
# manual=只匯出上架包 | dryrun=自動填好不發佈（先測這個）| auto=自動發佈
UPLOAD_MODE=manual
SHOPEE_VIDEO_UPLOAD_URL=
AFFILIATE_PICKS_URL=
APP_PASSWORD=
POLL_SECONDS=60
PORT=8000

# ===== 瀏覽器自動化（browser / flow_browser 模式）=====
CHROME_PATH=
CDP_PORT=9222
FLOW_CLIPS_PER_PRODUCT=2
DATA_DIR=data
